# Observation receiver for https://osmsfm.duckdns.org/ (server/ingest.py).
# Installed by publish.py into /etc/systemd/system/. One Python process
# from the standard library, about 20 MB RSS, listens only on 127.0.0.1:8781;
# from outside it is reached through nginx (location /api/ in server/osmsfm.nginx.conf).

[Unit]
Description=osmsfm price ingest (pricetrack)
After=network.target

[Service]
User=www-data
Group=www-data
Environment=OSMSFM_TOKEN_FILE=/etc/osmsfm/token
Environment=OSMSFM_DB=/var/lib/osmsfm/prices.sqlite
Environment=OSMSFM_WEB=/var/www/osmsfm
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/osmsfm/ingest.py
Restart=on-failure
RestartSec=5
MemoryMax=150M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/osmsfm /var/www/osmsfm
PrivateTmp=true

[Install]
WantedBy=multi-user.target
